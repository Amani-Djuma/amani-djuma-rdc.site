<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WORLDCONNECT — Dashboard Exécutif, Contrats Universels, Facturation & Décaissements</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.sheetjs.com/xlsx-0.20.2/package/dist/xlsx.full.min.js"></script>
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <style>
        @media print {
            body * { visibility: hidden; }
            #print-modal-zone, #print-modal-zone * { visibility: visible; }
            #print-modal-zone { position: fixed; inset: 0; background: white; color: black; padding: 28px; z-index: 9999; }
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen antialiased">

    <!-- ACCÈS DIRECT AU DASHBOARD (PAS DE CONNEXION À L'ACCUEIL) -->
    <div id="main-dashboard">
        <header class="bg-slate-900/95 backdrop-blur border-b border-slate-800 px-4 sm:px-6 py-3.5 sticky top-0 z-30">
            <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-400 to-indigo-500 flex items-center justify-center font-black text-slate-950 text-lg">WC</div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h1 class="font-extrabold text-sm sm:text-base text-white">WORLDCONNECT — Cockpit Exécutif</h1>
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-500/20 text-emerald-300 border border-emerald-700">ACCÈS DIRECT</span>
                        </div>
                        <p class="text-[11px] text-cyan-400 font-medium">Gestion Unifiée : Contrats Universels, Salaires, Services & Facturation</p>
                    </div>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <button onclick="exportAllExcel()" class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-extrabold px-3.5 py-2 rounded-xl flex items-center gap-1.5 shadow">
                        <i class="ph-bold ph-microsoft-excel-logo text-base"></i> Exporter Tout (.XLSX)
                    </button>
                </div>
            </div>
        </header>

        <main class="max-w-7xl mx-auto p-4 sm:p-6 space-y-6">
            <!-- BANDEAU KPI EXÉCUTIFS -->
            <section class="bg-gradient-to-r from-slate-900 via-indigo-950/60 to-slate-900 border border-indigo-800/60 rounded-3xl p-5 shadow-xl space-y-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div>
                        <h2 class="text-sm sm:text-base font-extrabold text-white uppercase tracking-wide flex items-center gap-2">
                            <i class="ph-fill ph-crown text-amber-400"></i> Situation Financière & Trésorerie en Temps Réel
                        </h2>
                        <p class="text-xs text-slate-400">Synthèse consolidée : Chiffre d'affaires facturé, décaissements salaires, autres services et bénéfice distribuable.</p>
                    </div>
                    <div class="flex items-center gap-2 text-xs">
                        <div class="bg-slate-950 px-3 py-1.5 rounded-xl border border-slate-800 flex items-center gap-1.5">
                            <span class="text-slate-400">1$ =</span>
                            <input type="number" id="cfg-cdf" value="2850" oninput="recalc()" class="w-16 bg-transparent font-mono font-bold text-cyan-400 focus:outline-none">
                            <span class="text-slate-400">FC</span>
                        </div>
                        <div class="bg-slate-950 px-3 py-1.5 rounded-xl border border-slate-800 flex items-center gap-1.5">
                            <span class="text-slate-400">TVA:</span>
                            <input type="number" id="cfg-tva" value="16" oninput="recalc()" class="w-10 bg-transparent font-mono font-bold text-cyan-400 focus:outline-none">
                            <span class="text-slate-400">%</span>
                        </div>
                        <div class="bg-slate-950 px-3 py-1.5 rounded-xl border border-slate-800 flex items-center gap-1.5">
                            <span class="text-slate-400">Réserve:</span>
                            <input type="number" id="cfg-res" value="10" oninput="recalc()" class="w-10 bg-transparent font-mono font-bold text-amber-400 focus:outline-none">
                            <span class="text-slate-400">%</span>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
                    <div class="bg-slate-950/90 p-3.5 rounded-2xl border border-slate-800">
                        <span class="text-[10px] font-bold uppercase text-slate-400">CA Facturé Multi-Services</span>
                        <p id="kpi-ca" class="text-lg font-extrabold text-white mt-1">$0</p>
                        <p id="kpi-ca-fc" class="text-[10px] font-mono text-slate-400">0 FC</p>
                    </div>
                    <div class="bg-slate-950/90 p-3.5 rounded-2xl border border-emerald-900/60">
                        <span class="text-[10px] font-bold uppercase text-emerald-400">Cash Réel Encaissé</span>
                        <p id="kpi-paid" class="text-lg font-extrabold text-emerald-400 mt-1">$0</p>
                        <p id="kpi-due" class="text-[10px] font-mono text-amber-400">Créances: $0</p>
                    </div>
                    <div class="bg-slate-950/90 p-3.5 rounded-2xl border border-rose-900/60">
                        <span class="text-[10px] font-bold uppercase text-rose-400">Décaissements Salaires</span>
                        <p id="kpi-sal" class="text-lg font-extrabold text-rose-400 mt-1">$0</p>
                        <p class="text-[10px] text-slate-400">Paie & Primes</p>
                    </div>
                    <div class="bg-slate-950/90 p-3.5 rounded-2xl border border-orange-900/60">
                        <span class="text-[10px] font-bold uppercase text-orange-400">Décaissements Services</span>
                        <p id="kpi-srv" class="text-lg font-extrabold text-orange-400 mt-1">$0</p>
                        <p class="text-[10px] text-slate-400">Loyer, IT, Prestataires</p>
                    </div>
                    <div class="bg-slate-950/90 p-3.5 rounded-2xl border border-slate-800">
                        <span class="text-[10px] font-bold uppercase text-amber-400">Réserve Société</span>
                        <p id="kpi-res" class="text-lg font-extrabold text-amber-300 mt-1">$0</p>
                        <p class="text-[10px] text-slate-400">Fonds protégé</p>
                    </div>
                    <div class="bg-gradient-to-br from-emerald-600 to-teal-800 p-3.5 rounded-2xl border border-emerald-400 shadow-lg">
                        <span class="text-[10px] font-bold uppercase text-emerald-100">Bénéfice Net Associés</span>
                        <p id="kpi-net" class="text-lg font-black text-white mt-1">$0</p>
                        <p id="kpi-net-fc" class="text-[10px] font-mono text-emerald-100">0 FC</p>
                    </div>
                </div>
            </section>

            <!-- MODULE 1 : CONTRATS UNIVERSELS (POUR TOUT LE MONDE) -->
            <section class="bg-slate-900 rounded-3xl border border-slate-800 p-5 sm:p-6 space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <div>
                        <h2 class="text-base font-extrabold text-white flex items-center gap-2">
                            <i class="ph-fill ph-users-three text-cyan-400"></i> 1. Contrats Universels (Pour Tout le Monde : Salariés, Associés, Prestataires, Formateurs)
                        </h2>
                        <p class="text-xs text-slate-400">Gérez les contrats de toute l'équipe. Chaque contrat dispose d'un accès Word (.doc) pour modifier et PDF pour enregistrer ou envoyer.</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <span id="badge-pct-total" class="text-xs font-extrabold px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300">Total Parts : 100%</span>
                        <button onclick="addPartner()" class="bg-cyan-500 hover:bg-cyan-400 text-slate-950 text-xs font-extrabold px-3.5 py-2 rounded-xl">+ Nouveau Collaborateur / Contrat</button>
                    </div>
                </div>

                <div id="partners-cards" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
            </section>

            <!-- MODULE 2 : FACTURATION MULTI-SERVICES -->
            <section class="bg-slate-900 rounded-3xl border border-slate-800 p-5 sm:p-6 space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <div>
                        <h2 class="text-base font-extrabold text-white flex items-center gap-2">
                            <i class="ph-fill ph-receipt text-emerald-400"></i> 2. Facturation Multi-Services (Call Center, Academy, IT, Consulting, Livraison)
                        </h2>
                        <p class="text-xs text-slate-400">Facturez tous les services et suivez les encaissements avec reçus PDF officiels.</p>
                    </div>
                </div>

                <form onsubmit="addServiceInvoice(event)" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-7 gap-2.5 text-xs bg-slate-950 p-4 rounded-2xl border border-slate-800">
                    <div>
                        <label class="block text-slate-400 font-bold mb-1">Client *</label>
                        <input type="text" id="inv-client" required placeholder="Nom du client" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-2.5 py-2 text-white font-semibold">
                    </div>
                    <div>
                        <label class="block text-slate-400 font-bold mb-1">Service *</label>
                        <select id="inv-service" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-2.5 py-2 text-cyan-300 font-bold">
                            <option value="Call Center B2B">Call Center B2B</option>
                            <option value="Développement Web & IT">Développement Web & IT</option>
                            <option value="WorldConnect Academy">WorldConnect Academy</option>
                            <option value="Consulting & Audit">Consulting & Audit</option>
                            <option value="Livraison & Logistique">Livraison & Logistique</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-slate-400 font-bold mb-1">Prestation *</label>
                        <input type="text" id="inv-desc" required placeholder="Détail..." class="w-full bg-slate-900 border border-slate-700 rounded-xl px-2.5 py-2 text-white">
                    </div>
                    <div>
                        <label class="block text-slate-400 font-bold mb-1">Qté</label>
                        <input type="number" id="inv-qty" value="1" min="1" required class="w-full bg-slate-900 border border-slate-700 rounded-xl px-2.5 py-2 font-mono text-white">
                    </div>
                    <div>
                        <label class="block text-slate-400 font-bold mb-1">Prix Unit. ($)</label>
                        <input type="number" id="inv-pu" value="500" step="0.01" required class="w-full bg-slate-900 border border-slate-700 rounded-xl px-2.5 py-2 font-mono text-cyan-400 font-bold">
                    </div>
                    <div>
                        <label class="block text-slate-400 font-bold mb-1">Statut</label>
                        <select id="inv-status" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-2.5 py-2 text-white font-semibold">
                            <option value="Payée">Payée</option>
                            <option value="Paiement Partiel">Paiement Partiel</option>
                            <option value="En attente">En attente</option>
                        </select>
                    </div>
                    <div class="flex items-end">
                        <button type="submit" class="w-full bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold py-2 px-3 rounded-xl">+ Facturer</button>
                    </div>
                </form>

                <div class="overflow-x-auto rounded-2xl border border-slate-800">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="border-b border-slate-800 text-slate-400 uppercase text-[11px] bg-slate-950">
                                <th class="py-2.5 px-3">N° Facture</th>
                                <th class="py-2.5 px-3">Client</th>
                                <th class="py-2.5 px-3">Service</th>
                                <th class="py-2.5 px-3">Prestation</th>
                                <th class="py-2.5 px-3">Total TTC ($)</th>
                                <th class="py-2.5 px-3">Encaissé ($)</th>
                                <th class="py-2.5 px-3">Statut</th>
                                <th class="py-2.5 px-3 text-right">Reçu PDF</th>
                            </tr>
                        </thead>
                        <tbody id="invoices-tbody" class="divide-y divide-slate-800"></tbody>
                    </table>
                </div>
            </section>

            <!-- MODULE 3 : DÉCAISSEMENTS SALAIRES & AUTRES SERVICES -->
            <section class="bg-slate-900 rounded-3xl border border-slate-800 p-5 sm:p-6 space-y-4">
                <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
                    <div>
                        <h2 class="text-base font-extrabold text-white flex items-center gap-2">
                            <i class="ph-fill ph-money text-rose-400"></i> 3. Décaissements de Salaires & Autres Services
                        </h2>
                        <p class="text-xs text-slate-400">Enregistrez les décaissements de salaires du personnel et les autres charges de services (loyer, fibre, prestataires).</p>
                    </div>
                    <div class="flex flex-wrap items-center gap-2 text-xs">
                        <select id="filter-dec-type" onchange="recalc()" class="bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-white font-semibold">
                            <option value="ALL">Tous décaissements</option>
                            <option value="Salaire & Paie">Salaires & Paie</option>
                            <option value="Autre Service Externe">Autres Services</option>
                        </select>
                        <button onclick="exportDisbursementsExcel()" class="bg-rose-600 hover:bg-rose-500 text-white font-bold px-3.5 py-2 rounded-xl flex items-center gap-1.5">
                            <i class="ph-bold ph-file-xls"></i> Exporter Décaissements
                        </button>
                    </div>
                </div>

                <form onsubmit="addDisbursement(event)" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-2.5 text-xs bg-slate-950 p-4 rounded-2xl border border-slate-800">
                    <div>
                        <label class="block text-slate-400 font-bold mb-1">Type *</label>
                        <select id="dec-type" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-2.5 py-2 text-rose-300 font-bold">
                            <option value="Salaire & Paie">Salaire & Paie</option>
                            <option value="Autre Service Externe">Autre Service Externe</option>
                            <option value="Loyer & Bureaux">Loyer & Bureaux</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-slate-400 font-bold mb-1">Bénéficiaire *</label>
                        <input type="text" id="dec-ben" required placeholder="Nom bénéficiaire..." class="w-full bg-slate-900 border border-slate-700 rounded-xl px-2.5 py-2 text-white">
                    </div>
                    <div>
                        <label class="block text-slate-400 font-bold mb-1">Motif *</label>
                        <input type="text" id="dec-motif" required placeholder="Motif..." class="w-full bg-slate-900 border border-slate-700 rounded-xl px-2.5 py-2 text-white">
                    </div>
                    <div>
                        <label class="block text-slate-400 font-bold mb-1">Montant ($) *</label>
                        <input type="number" id="dec-amount" required step="0.01" min="1" placeholder="450" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-2.5 py-2 font-mono font-bold text-rose-400">
                    </div>
                    <div>
                        <label class="block text-slate-400 font-bold mb-1">Statut</label>
                        <select id="dec-status" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-2.5 py-2 text-white font-semibold">
                            <option value="Payé">Payé</option>
                            <option value="Approuvé">Approuvé</option>
                        </select>
                    </div>
                    <div class="flex items-end">
                        <button type="submit" class="w-full bg-rose-600 hover:bg-rose-500 text-white font-extrabold py-2 px-3 rounded-xl">+ Décaisser</button>
                    </div>
                </form>

                <div class="overflow-x-auto rounded-2xl border border-slate-800">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="border-b border-slate-800 text-slate-400 uppercase text-[11px] bg-slate-950">
                                <th class="py-2.5 px-3">Réf</th>
                                <th class="py-2.5 px-3">Date</th>
                                <th class="py-2.5 px-3">Type</th>
                                <th class="py-2.5 px-3">Bénéficiaire</th>
                                <th class="py-2.5 px-3">Motif</th>
                                <th class="py-2.5 px-3">Montant ($)</th>
                                <th class="py-2.5 px-3">Montant (FC)</th>
                                <th class="py-2.5 px-3">Statut</th>
                                <th class="py-2.5 px-3 text-right">Bon PDF</th>
                            </tr>
                        </thead>
                        <tbody id="disbursements-tbody" class="divide-y divide-slate-800"></tbody>
                    </table>
                </div>
            </section>
        </main>
    </div>

    <!-- MODALE CONTRAT WORD / PDF -->
    <div id="contract-modal" class="fixed inset-0 bg-slate-950/85 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-700 rounded-3xl max-w-3xl w-full p-6 shadow-2xl space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-3">
                <div>
                    <h3 id="ctr-modal-title" class="text-base font-extrabold text-white">Contrat Universel — Édition Word & Export PDF</h3>
                    <p class="text-xs text-slate-400">Modifiez le contrat pour n'importe quel collaborateur, téléchargez-le en <strong>Word (.doc)</strong> ou enregistrez en <strong>PDF</strong>.</p>
                </div>
                <button onclick="document.getElementById('contract-modal').classList.add('hidden')" class="px-3 py-1.5 rounded-xl bg-slate-800 text-slate-300 text-xs font-bold">Fermer</button>
            </div>

            <textarea id="ctr-editor-text" rows="13" class="w-full bg-white text-slate-900 rounded-2xl p-5 font-serif text-sm leading-relaxed focus:outline-none shadow-inner"></textarea>

            <div class="flex flex-wrap items-center justify-between gap-2 pt-2">
                <button onclick="saveContractEdits()" class="bg-slate-800 hover:bg-slate-700 text-emerald-400 border border-slate-700 text-xs font-extrabold px-4 py-2.5 rounded-xl">Enregistrer</button>
                <div class="flex flex-wrap items-center gap-2">
                    <button onclick="downloadContractAsWord()" class="bg-blue-600 hover:bg-blue-500 text-white text-xs font-extrabold px-4 py-2.5 rounded-xl flex items-center gap-1.5">
                        <i class="ph-bold ph-file-doc text-base"></i> Word (.DOC)
                    </button>
                    <button onclick="printContractAsPDF()" class="bg-rose-600 hover:bg-rose-500 text-white text-xs font-extrabold px-4 py-2.5 rounded-xl flex items-center gap-1.5">
                        <i class="ph-bold ph-file-pdf text-base"></i> Enregistrer PDF
                    </button>
                    <button onclick="sendContractWhatsApp()" class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-extrabold px-4 py-2.5 rounded-xl flex items-center gap-1.5">
                        <i class="ph-bold ph-paper-plane-tilt text-base"></i> WhatsApp
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODALE IMPRESSION PDF -->
    <div id="receipt-modal" class="fixed inset-0 bg-slate-950/85 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white text-slate-900 rounded-3xl max-w-2xl w-full p-6 shadow-2xl space-y-4">
            <div id="print-modal-zone" class="space-y-4"></div>
            <div class="flex justify-end gap-2 pt-3 border-t border-slate-200">
                <button onclick="document.getElementById('receipt-modal').classList.add('hidden')" class="px-4 py-2 rounded-xl bg-slate-200 text-slate-800 text-xs font-bold">Fermer</button>
                <button onclick="window.print()" class="px-4 py-2 rounded-xl bg-indigo-600 text-white text-xs font-extrabold flex items-center gap-1.5">
                    <i class="ph-bold ph-printer"></i> Imprimer / PDF
                </button>
            </div>
        </div>
    </div>

