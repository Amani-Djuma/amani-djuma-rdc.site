            ],
            disbursements: [
                { ref: 'DEC-SAL-01', date: '2026-11-05', type: 'Salaire & Paie', ben: 'Amani Djuma (Directeur Général)', motif: 'Salaire mensuel & prime', amount: 1025, status: 'Payé' },
                { ref: 'DEC-SAL-02', date: '2026-11-05', type: 'Salaire & Paie', ben: 'Patrick Ilunga (Directeur Opérations)', motif: 'Salaire mensuel', amount: 780, status: 'Payé' },
                { ref: 'DEC-SRV-01', date: '2026-11-08', type: 'Autre Service Externe', ben: 'Fournisseur Fibre & Cloud', motif: 'Bande passante', amount: 450, status: 'Payé' }
            ]
        };

        function saveDB() {
            localStorage.setItem(DB_KEY, JSON.stringify(db));
        }

        function addServiceInvoice(e) {
            e.preventDefault();
            db.invoices.unshift({
                num: 'FAC-2026-' + String(db.invoices.length + 1).padStart(3, '0'),
                date: new Date().toISOString().slice(0, 10),
                client: document.getElementById('inv-client').value.trim(),
                service: document.getElementById('inv-service').value,
                desc: document.getElementById('inv-desc').value.trim(),
                qty: Number(document.getElementById('inv-qty').value),
                pu: Number(document.getElementById('inv-pu').value),
                status: document.getElementById('inv-status').value
            });
            document.getElementById('inv-client').value = '';
            document.getElementById('inv-desc').value = '';
            saveDB(); recalc();
        }

        function addDisbursement(e) {
            e.preventDefault();
            const type = document.getElementById('dec-type').value;
            db.disbursements.unshift({
                ref: (type === 'Salaire & Paie' ? 'DEC-SAL-' : 'DEC-SRV-') + String(db.disbursements.length + 1).padStart(2, '0'),
                date: new Date().toISOString().slice(0, 10),
                type,
                ben: document.getElementById('dec-ben').value.trim(),
                motif: document.getElementById('dec-motif').value.trim(),
                amount: Number(document.getElementById('dec-amount').value),
                status: document.getElementById('dec-status').value
            });
            document.getElementById('dec-ben').value = '';
            document.getElementById('dec-motif').value = '';
            document.getElementById('dec-amount').value = '';
            saveDB(); recalc();
        }

        function addPartner() {
            const name = prompt('Nom & Prénom du collaborateur ou associé :');
            if (!name) return;
            const role = prompt('Qualité / Rôle (ex: Salarié, Formateur, Associé) :', 'Collaborateur') || 'Collaborateur';
            const cap = Number(prompt('Apport ou Salaire de base ($) :', '1000') || 0);
            const pct = Number(prompt('Pourcentage de part (%) :', '5') || 5);
            const code = 'CONT-' + String(db.partners.length + 1).padStart(2, '0');
            const ref = 'CTR-WC-2026-' + String(db.partners.length + 1).padStart(2, '0');
            db.partners.push({
                code, name, role, capital: cap, pct, contractRef: ref, contractStatus: 'Actif', phone: '+243810000000',
                contractText: `CONTRAT UNIVERSEL N° ${ref}\n\nENTRE : WORLDCONNECT SARL\nET : ${name} (${role})\n\nARTICLE 1 — OBJET : Contrat universel de collaboration.\nARTICLE 2 — CONDITIONS : Rémunération / Quote-part de ${pct}%.`
            });
            saveDB(); recalc();
        }

        function updatePartnerPct(idx, val) {
            db.partners[idx].pct = Number(val || 0);
            saveDB(); recalc();
        }

        function updatePartnerStatus(idx, st) {
            db.partners[idx].contractStatus = st;
            saveDB(); recalc();
        }

        function openContractEditor(idx) {
            editingPartnerIdx = idx;
            const p = db.partners[idx];
            document.getElementById('ctr-modal-title').textContent = `Contrat Universel ${p.contractRef} — ${p.name}`;
            document.getElementById('ctr-editor-text').value = p.contractText;
            document.getElementById('contract-modal').classList.remove('hidden');
        }

        function saveContractEdits() {
            if (editingPartnerIdx === null) return;
            db.partners[editingPartnerIdx].contractText = document.getElementById('ctr-editor-text').value;
            saveDB();
            alert('Contrat mis à jour avec succès.');
        }

        function downloadContractAsWord() {
            if (editingPartnerIdx === null) return;
            saveContractEdits();
            const p = db.partners[editingPartnerIdx];
            const html = `<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'><head><meta charset='utf-8'></head><body style="font-family:Calibri;padding:30px;"><h2>WORLDCONNECT — ${p.contractRef}</h2><pre style="white-space:pre-wrap;font-family:Calibri;font-size:12pt;">${p.contractText}</pre></body></html>`;
            const blob = new Blob(['﻿', html], { type: 'application/msword' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url; a.download = `Contrat_${p.name.replace(/\s+/g, '_')}_${p.contractRef}.doc`;
            a.click(); URL.revokeObjectURL(url);
        }

        function printContractAsPDF() {
            if (editingPartnerIdx === null) return;
            saveContractEdits();
            const p = db.partners[editingPartnerIdx];
            document.getElementById('contract-modal').classList.add('hidden');
            document.getElementById('print-modal-zone').innerHTML = `
                <div class="border-b-2 border-slate-900 pb-4 flex justify-between items-start">
                    <div><h2 class="text-xl font-extrabold text-slate-900">WORLDCONNECT SARL</h2><p class="text-xs text-slate-500">Contrat Universel Officiel</p></div>
                    <div class="text-right"><span class="px-3 py-1 rounded-full text-xs font-extrabold bg-indigo-100 text-indigo-800">${p.contractRef}</span><p class="text-xs font-mono font-bold mt-1">Statut : ${p.contractStatus}</p></div>
                </div>
                <div class="whitespace-pre-wrap font-serif text-sm leading-relaxed text-slate-800 bg-slate-50 p-5 rounded-2xl border border-slate-200">${p.contractText}</div>
                <div class="grid grid-cols-2 gap-6 pt-6 text-xs">
                    <div class="border-t border-slate-400 pt-2"><strong>Direction Générale</strong><br>Cachet & Signature</div>
                    <div class="border-t border-slate-400 pt-2 text-right"><strong>${p.name}</strong><br>Lu et approuvé</div>
                </div>
            `;
            document.getElementById('receipt-modal').classList.remove('hidden');
        }

        function sendContractWhatsApp() {
            if (editingPartnerIdx === null) return;
            saveContractEdits();
            const p = db.partners[editingPartnerIdx];
            window.open(`https://wa.me/${(p.phone || '').replace(/\D/g, '')}?text=` + encodeURIComponent(`Bonjour ${p.name}, voici votre contrat ${p.contractRef} chez WORLDCONNECT:

${p.contractText}`), '_blank');
        }

        function openInvoiceReceipt(idx) {
            const inv = db.invoices[idx];
            const ttc = (inv.qty * inv.pu) * (1 + db.tva / 100);
            const cdf = Math.round(ttc * db.cdfRate);
            document.getElementById('print-modal-zone').innerHTML = `
                <div class="border-b-2 border-slate-900 pb-4 flex justify-between items-start">
                    <div><h2 class="text-xl font-extrabold text-slate-900">WORLDCONNECT SARL</h2><p class="text-xs text-slate-500">Reçu Officiel Multi-Services</p></div>
                    <div class="text-right"><span class="px-3 py-1 rounded-full text-xs font-extrabold bg-emerald-100 text-emerald-800">REÇU</span><p class="text-xs font-mono font-bold mt-1">${inv.num}</p></div>
                </div>
                <div class="bg-slate-50 p-4 rounded-2xl text-xs space-y-1">
                    <p><span class="text-slate-500">Client :</span> <strong>${inv.client}</strong></p>
                    <p><span class="text-slate-500">Service :</span> <strong>${inv.service}</strong> — ${inv.desc}</p>
                </div>
                <div class="p-4 rounded-2xl bg-slate-900 text-white flex justify-between items-center">
                    <div><p class="text-[11px] uppercase text-slate-400">Total TTC</p><p class="text-xs text-cyan-300 font-mono">${cdf.toLocaleString('fr-FR')} FC</p></div>
                    <span class="text-2xl font-extrabold text-emerald-400">$${ttc.toFixed(2)}</span>
                </div>
            `;
            document.getElementById('receipt-modal').classList.remove('hidden');
        }

        function openDisbursementReceipt(idx) {
            const d = db.disbursements[idx];
            document.getElementById('print-modal-zone').innerHTML = `
                <div class="border-b-2 border-slate-900 pb-4 flex justify-between items-start">
                    <div><h2 class="text-xl font-extrabold text-slate-900">WORLDCONNECT SARL</h2><p class="text-xs text-slate-500">Bon de Décaissement</p></div>
                    <div class="text-right"><span class="px-3 py-1 rounded-full text-xs font-extrabold bg-rose-100 text-rose-800">${d.type}</span><p class="text-xs font-mono font-bold mt-1">${d.ref}</p></div>
                </div>
                <div class="bg-slate-50 p-4 rounded-2xl text-xs space-y-1.5">
                    <p><span class="text-slate-500">Bénéficiaire :</span> <strong>${d.ben}</strong></p>
                    <p><span class="text-slate-500">Motif :</span> <strong>${d.motif}</strong></p>
                </div>
                <div class="p-4 rounded-2xl bg-slate-900 text-white flex justify-between items-center">
                    <div><p class="text-[11px] uppercase text-slate-400">Montant Décaissé</p><p class="text-xs text-cyan-300 font-mono">${Math.round(d.amount * db.cdfRate).toLocaleString('fr-FR')} FC</p></div>
                    <span class="text-2xl font-extrabold text-rose-400">$${d.amount.toFixed(2)}</span>
                </div>
            `;
            document.getElementById('receipt-modal').classList.remove('hidden');
        }

        function recalc() {
            db.cdfRate = Number(document.getElementById('cfg-cdf').value || 2850);
            db.tva = Number(document.getElementById('cfg-tva').value || 16);
            db.reservePct = Number(document.getElementById('cfg-res').value || 10);

            let totalCA = 0, totalPaid = 0, totalDue = 0;
            document.getElementById('invoices-tbody').innerHTML = db.invoices.map((inv, idx) => {
                const ttc = (inv.qty * inv.pu) * (1 + db.tva / 100);
                const paid = inv.status === 'Payée' ? ttc : (inv.status === 'Paiement Partiel' ? ttc * 0.5 : 0);
                totalCA += ttc; totalPaid += paid; totalDue += Math.max(0, ttc - paid);
                return `
                    <tr class="hover:bg-slate-800/40">
                        <td class="py-2.5 px-3 font-mono font-bold text-indigo-400">${inv.num}</td>
                        <td class="py-2.5 px-3 font-bold text-white">${inv.client}</td>
                        <td class="py-2.5 px-3 text-cyan-300 font-semibold">${inv.service}</td>
                        <td class="py-2.5 px-3 text-slate-300">${inv.desc}</td>
                        <td class="py-2.5 px-3 font-mono">$${ttc.toFixed(2)}</td>
                        <td class="py-2.5 px-3 font-mono font-bold text-emerald-400">$${paid.toFixed(2)}</td>
                        <td class="py-2.5 px-3"><span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-500/20 text-emerald-300">${inv.status}</span></td>
                        <td class="py-2.5 px-3 text-right"><button onclick="openInvoiceReceipt(${idx})" class="bg-slate-800 hover:bg-indigo-600 text-white text-[10px] font-bold px-2.5 py-1 rounded-lg">Reçu</button></td>
                    </tr>
                `;
            }).join('');

            let salOut = 0, srvOut = 0;
            db.disbursements.forEach(d => { if (d.type === 'Salaire & Paie') salOut += d.amount; else srvOut += d.amount; });

            const filterType = document.getElementById('filter-dec-type').value;
            document.getElementById('disbursements-tbody').innerHTML = db.disbursements
                .filter(d => filterType === 'ALL' || d.type === filterType)
                .map((d, idx) => `
                    <tr class="hover:bg-slate-800/40">
                        <td class="py-2.5 px-3 font-mono font-bold text-rose-400">${d.ref}</td>
                        <td class="py-2.5 px-3 text-slate-300">${d.date}</td>
                        <td class="py-2.5 px-3 font-bold text-cyan-300">${d.type}</td>
                        <td class="py-2.5 px-3 font-bold text-white">${d.ben}</td>
                        <td class="py-2.5 px-3 text-slate-300">${d.motif}</td>
                        <td class="py-2.5 px-3 font-mono font-extrabold text-rose-400">$${d.amount.toFixed(2)}</td>
                        <td class="py-2.5 px-3 font-mono text-slate-200">${Math.round(d.amount * db.cdfRate).toLocaleString('fr-FR')} FC</td>
                        <td class="py-2.5 px-3"><span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-500/20 text-emerald-300">${d.status}</span></td>
                        <td class="py-2.5 px-3 text-right"><button onclick="openDisbursementReceipt(${idx})" class="bg-slate-800 hover:bg-rose-600 text-white text-[10px] font-bold px-2.5 py-1 rounded-lg">Bon</button></td>
                    </tr>
                `).join('');

            const grossNet = Math.max(0, totalPaid - salOut - srvOut);
            const resAmt = grossNet * (db.reservePct / 100);
            const distNet = Math.max(0, grossNet - resAmt);

            document.getElementById('kpi-ca').textContent = '$' + totalCA.toLocaleString('en-US', { maximumFractionDigits: 0 });
            document.getElementById('kpi-ca-fc').textContent = Math.round(totalCA * db.cdfRate).toLocaleString('fr-FR') + ' FC';
            document.getElementById('kpi-paid').textContent = '$' + totalPaid.toLocaleString('en-US', { maximumFractionDigits: 0 });
            document.getElementById('kpi-due').textContent = 'Créances: $' + totalDue.toLocaleString('en-US', { maximumFractionDigits: 0 });
            document.getElementById('kpi-sal').textContent = '$' + salOut.toLocaleString('en-US', { maximumFractionDigits: 0 });
            document.getElementById('kpi-srv').textContent = '$' + srvOut.toLocaleString('en-US', { maximumFractionDigits: 0 });
            document.getElementById('kpi-res').textContent = '$' + resAmt.toLocaleString('en-US', { maximumFractionDigits: 0 });
            document.getElementById('kpi-net').textContent = '$' + distNet.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('kpi-net-fc').textContent = Math.round(distNet * db.cdfRate).toLocaleString('fr-FR') + ' FC';

            const totalPct = db.partners.reduce((s, p) => s + Number(p.pct || 0), 0);
            document.getElementById('badge-pct-total').textContent = `Total Parts : ${totalPct}%`;

            document.getElementById('partners-cards').innerHTML = db.partners.map((p, idx) => {
                const share = distNet * (p.pct / 100);
                return `
                    <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 space-y-3 text-xs">
                        <div class="flex items-start justify-between gap-2">
                            <div>
                                <p class="font-extrabold text-sm text-white">${p.name}</p>
                                <p class="text-[11px] text-slate-400">${p.role} • Base: $${Number(p.capital || 0).toLocaleString()}</p>
                            </div>
                            <div class="flex items-center gap-1 bg-slate-900 border border-slate-700 rounded-xl px-2 py-1">
                                <input type="number" value="${p.pct}" min="0" max="100" step="0.5" onchange="updatePartnerPct(${idx}, this.value)" class="w-12 bg-transparent text-right font-mono font-extrabold text-cyan-400 focus:outline-none">
                                <span class="text-cyan-400 font-bold">%</span>
                            </div>
                        </div>
                        <div class="flex flex-wrap items-center justify-between gap-2 bg-slate-900/90 p-2.5 rounded-xl border border-slate-800">
                            <div>
                                <span class="text-[10px] uppercase text-slate-400 block">Quote-part / Dividende Net</span>
                                <span class="font-mono font-black text-emerald-400 text-sm">$${share.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
                            </div>
                            <select onchange="updatePartnerStatus(${idx}, this.value)" class="bg-slate-950 border border-slate-700 rounded-lg px-2 py-1 text-[11px] font-bold text-amber-300">
                                <option value="Actif" ${p.contractStatus === 'Actif' ? 'selected' : ''}>Actif</option>
                                <option value="En révision" ${p.contractStatus === 'En révision' ? 'selected' : ''}>En révision</option>
                                <option value="Suspendu" ${p.contractStatus === 'Suspendu' ? 'selected' : ''}>Suspendu</option>
                            </select>
                        </div>
                        <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
                            <span class="text-[11px] font-mono text-slate-400">Réf : <strong class="text-slate-200">${p.contractRef}</strong></span>
                            <button onclick="openContractEditor(${idx})" class="bg-indigo-600 hover:bg-indigo-500 text-white font-extrabold px-3 py-1.5 rounded-xl flex items-center gap-1.5">
                                <i class="ph-bold ph-file-text"></i> Contrat Word / PDF & Envoyer
                            </button>
                        </div>
                    </div>
                `;
            }).join('');

            saveDB();
        }

        function exportAllExcel() {
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(db.invoices), 'Facturation');
            XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(db.disbursements), 'Decaissements');
            XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(db.partners), 'Contrats_Universels');
            XLSX.writeFile(wb, 'WorldConnect_Dashboard_Executif_Complet.xlsx');
        }

        window.onload = recalc;
    </script>
</body>
</html>
